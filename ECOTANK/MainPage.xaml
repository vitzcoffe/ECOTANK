<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ECOTANK.MainPage"
             Title="ECOTANK">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Label
                Text="ECOTANK"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Registro y login conectados a MySQL"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                Text="Preparar base de datos"
                Clicked="OnPrepareDatabaseClicked"
                HorizontalOptions="Fill" />

            <BoxView HeightRequest="1" Color="#D8E1DB" />

            <Label
                Text="Crear usuario"
                FontAttributes="Bold"
                FontSize="20" />

            <Entry
                x:Name="FullNameEntry"
                Placeholder="Nombre completo"
                ReturnType="Next" />

            <Entry
                x:Name="RegisterEmailEntry"
                Placeholder="Correo"
                Keyboard="Email"
                ReturnType="Next" />

            <Entry
                x:Name="RegisterPasswordEntry"
                Placeholder="Contrasena"
                IsPassword="True"
                ReturnType="Done" />

            <Picker
                x:Name="RolePicker"
                Title="Rol" />

            <Button
                Text="Registrar"
                Clicked="OnRegisterClicked"
                HorizontalOptions="Fill" />

            <BoxView HeightRequest="1" Color="#D8E1DB" />

            <Label
                Text="Iniciar sesion"
                FontAttributes="Bold"
                FontSize="20" />

            <Entry
                x:Name="LoginEmailEntry"
                Placeholder="Correo"
                Keyboard="Email"
                ReturnType="Next" />

            <Entry
                x:Name="LoginPasswordEntry"
                Placeholder="Contrasena"
                IsPassword="True"
                ReturnType="Done" />

            <Button
                Text="Entrar"
                Clicked="OnLoginClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="StatusLabel"
                Text="Listo para probar la conexion."
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
